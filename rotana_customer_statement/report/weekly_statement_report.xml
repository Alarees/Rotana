<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_weekly_statement_document" model="ir.actions.report">
        <field name="name">كشف حساب أسبوعي / Weekly Customer Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rotana_customer_statement.report_weekly_statement</field>
        <field name="report_file">rotana_customer_statement.report_weekly_statement</field>
        <field name="print_report_name">'Statement - %s' % (object.name)</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_weekly_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="statement" t-value="o.get_weekly_statement_lines()"/>
                    <div class="page">
                        <h2 style="text-align:center;">كشف حساب / Account Statement</h2>

                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>العميل / Customer:</strong> <span t-esc="o.name"/><br/>
                                <t t-if="o.vat">
                                    <strong>الرقم الضريبي / VAT:</strong> <span t-esc="o.vat"/><br/>
                                </t>
                                <t t-if="o.phone">
                                    <strong>الهاتف / Phone:</strong>
                                    <span t-esc="o.phone"/>
                                </t>
                            </div>
                            <div class="col-6 text-end" style="text-align:right;">
                                <strong>الفترة / Period:</strong>
                                <span t-esc="statement['date_from']"/> -
                                <span t-esc="statement['date_to']"/><br/>
                                <strong>الرصيد الافتتاحي / Opening Balance:</strong>
                                <span t-esc="'%.2f' % statement['opening_balance']"/>
                                <span t-esc="o.currency_id.symbol or o.currency_id.name"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead style="background-color:#f2f2f2;">
                                <tr>
                                    <th>التاريخ / Date</th>
                                    <th>البيان / Reference</th>
                                    <th class="text-end">مدين (فاتورة) / Debit</th>
                                    <th class="text-end">دائن (سداد) / Credit</th>
                                    <th class="text-end">الرصيد / Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="4"><strong>الرصيد الافتتاحي / Opening Balance</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="'%.2f' % statement['opening_balance']"/>
                                    </td>
                                </tr>
                                <t t-foreach="statement['lines']" t-as="line">
                                    <tr>
                                        <td><span t-esc="line['date']"/></td>
                                        <td><span t-esc="line['label']"/></td>
                                        <td class="text-end">
                                            <span t-if="line['debit']" t-esc="'%.2f' % line['debit']"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-if="line['credit']" t-esc="'%.2f' % line['credit']"/>
                                        </td>
                                        <td class="text-end"><span t-esc="'%.2f' % line['balance']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="font-weight:bold; background-color:#f2f2f2;">
                                    <td colspan="2">الإجمالي / Total</td>
                                    <td class="text-end" t-esc="'%.2f' % statement['total_debit']"/>
                                    <td class="text-end" t-esc="'%.2f' % statement['total_credit']"/>
                                    <td class="text-end" t-esc="'%.2f' % statement['closing_balance']"/>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="mt-4">
                            <strong>الرصيد المستحق النهائي / Closing Balance:
                                <span t-esc="'%.2f' % statement['closing_balance']"/>
                                <span t-esc="o.currency_id.symbol or o.currency_id.name"/>
                            </strong>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
