<odoo>
    <template id="report_purchase_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div id="oe_structure_report_request_1" class="oe_structure" />
                        <h2>
                            Purchase Request
                            <span t-field="o.name" />
                        </h2>
                        <div class="row mt32 mb32">
                            <div class="col-2">
                                <strong>Request Reference:</strong>
                                <br />
                                <span t-field="o.name" />
                            </div>
                            <div class="col-2">
                                <strong>Creation Date:</strong>
                                <br />
                                <span t-field="o.date_start" />
                            </div>
                            <div class="col-2">
                                <strong>Source:</strong>
                                <br />
                                <span t-field="o.origin" />
                            </div>
                            <div class="col-2">
                                <strong>Requested by:</strong>
                                <br />
                                <span t-field="o.requested_by" />
                            </div>
                            <div class="col-2">
                                <strong>Assigned to:</strong>
                                <br />
                                <span t-field="o.assigned_to" />
                            </div>
                            <div class="col-2">
                                <strong>Vendor:</strong>
                                <br />
                                <span t-field="o.vendor_id" />
                            </div>
                        </div>
                        <div class="row mt32 mb32">
                            <div class="col-12">
                                <strong>Description:</strong>
                                <br />
                                <span t-field="o.description" />
                            </div>
                        </div>
                        <t t-if="o.line_ids">
                            <h3>Products</h3>
                            <table class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th>
                                            <strong>Description</strong>
                                        </th>
                                        <th groups="analytic.group_analytic_accounting">
                                            <strong>Analytic Distribution</strong>
                                        </th>
                                        <th class="text-end">
                                            <strong>Qty</strong>
                                        </th>
                                        <th class="text-end">
                                            <strong>Unit Price</strong>
                                        </th>
                                        <th class="text-end">
                                            <strong>Subtotal</strong>
                                        </th>
                                        <th class="text-end">
                                            <strong>Requested Date</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids" t-as="line_id">
                                        <td>
                                            <span t-field="line_id.description" />
                                        </td>
                                        <td groups="analytic.group_analytic_accounting">
                                            <span
                                                t-field="line_id.analytic_distribution"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line_id.product_qty" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line_id.price_unit" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line_id.price_subtotal" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line_id.date_required" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="row justify-content-end">
                                <div class="col-4">
                                    <strong>Total:</strong>
                                    <span t-field="o.amount_total" />
                                </div>
                            </div>
                        </t>
                        <div id="oe_structure_report_request_2" class="oe_structure" />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
