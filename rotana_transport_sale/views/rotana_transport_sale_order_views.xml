<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ============================== -->
    <!-- توسعة نموذج أمر البيع -->
    <!-- ============================== -->
    <record id="view_rotana_transport_sale_order_form" model="ir.ui.view">
        <field name="name">rotana.transport.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- زر إنشاء الرحلات (ويزرد اختيار المركبات) -->
            <xpath expr="//header" position="inside">
                <button name="action_open_trip_wizard"
                        type="object"
                        string="إنشاء رحلات"
                        class="btn-primary"
                        groups="rotana_transport_sale.group_rotana_transport_user"
                        invisible="not is_transport_order or state in ('draft', 'cancel')"/>
            </xpath>
            <!-- زر عرض الرحلات في الرأس -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_transport_trips"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="not is_transport_order or transport_trip_count == 0">
                    <field name="transport_trip_count" widget="statinfo" string="الرحلات"/>
                </button>
                <button name="action_view_account_analytic"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calculator"
                        invisible="not is_transport_order or analytic_account_count == 0">
                    <field name="analytic_account_count" widget="statinfo" string="الحسابات التحليلية"/>
                </button>
            </xpath>
            <!-- قسم بيانات النقل بعد مجموعة المعلومات الأساسية -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <group invisible="not is_transport_order">
                    <field name="transport_location_from_id"
                                   options="{'no_create': True}"/>
                    <field name="transport_location_to_id"
                                   options="{'no_create': True}"/>
                </group>
            </xpath>
            <!-- إضافة حقل الوزن المنقول في سطور أمر البيع -->
            <field name="payment_term_id" position="after">
                <field name="total_weight_to_transport"
                       string="إجمالي الوزن المراد نقله"
                       readonly="1"
                       invisible="not is_transport_order"/>
                <field name="total_transported_weight"
                       string="إجمالي الوزن المنقول"
                       readonly="1"
                       invisible="not is_transport_order"/>
                <field name="total_discharged_quantity"
                       string="إجمالي الكمية المفرغة"
                       readonly="1"
                       invisible="not is_transport_order"/>
            </field>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page name="transport_trips" string="الرحلات" invisible="not is_transport_order or state == 'draft'">
                    <field name="trip_ids" nolabel="1">
                        <list string="الرحلات" editable="bottom" create="true" delete="true">
                            <field name="vehicle_id" />
                            <field name="driver_id" />
                            <field name="transported_weight" />
                            <field name="allowable_deficit" />
                            <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-primary="state == 'in_transit'"
                       decoration-success="state == 'done'"/>
                            <button name="action_view_transport_trips" type="object" class="btn-primary" icon="fa-eye" string="عرض"  />
                        </list>
                    </field>
                </page>
            </xpath>
            <!-- إضافة الحساب التحليلي للمركبة في سطور أمر البيع -->
            <!-- <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
                <field name="transport_vehicle_analytic_account_id"
                       optional="show"
                       string="الحساب التحليلي للمركبة"
                       invisible="not parent.is_transport_order"/>
            </xpath> -->
        </field>
    </record>
    <!-- قائمة أوامر بيع النقل -->
    <record id="view_rotana_transport_sale_order_tree" model="ir.ui.view">
        <field name="name">rotana.transport.sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list string="أوامر بيع النقل"
              decoration-muted="state == 'cancel'"
              decoration-info="state in ('draft', 'sent')"
              decoration-success="state == 'sale'"
              decoration-warning="state == 'done'"
              decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="transport_location_from_id" optional="show"/>
                <field name="transport_location_to_id" optional="show"/>
                <field name="total_weight_to_transport" optional="show"/>
                <field name="total_transported_weight" widget="progressbar" optional="show"
                   options="{'current_value': 'total_transported_weight', 'max_value': 'total_weight_to_transport', 'editable': false}"/>
                <field name="amount_total" sum="الإجمالي" widget="monetary"/>
                <field name="state" widget="badge"
                   decoration-info="state in ('draft', 'sent')"
                   decoration-success="state == 'sale'"
                   decoration-warning="state == 'done'"
                   decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>
    <!-- كانبان أوامر بيع النقل: بطاقة عريضة لكل أمر (بدون تجميع) -->
    <record id="view_rotana_transport_sale_order_kanban" model="ir.ui.view">
        <field name="name">rotana.transport.sale.order.kanban</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <kanban class="o_transport_order_kanban"
                    default_order="date_order desc, id desc"
                    quick_create="0"
                    records_draggable="0"
                    group_create="false">
                <field name="state"/>
                <field name="total_weight_to_transport"/>
                <field name="total_transported_weight"/>
                <templates>
                    <t t-name="menu" class="d-flex flex-column">
                        <button name="action_view_transport_trips" type="object"
                                class="btn" string="عرض الرحلات"/>
                        <button name="action_open_trip_wizard" type="object"
                                class="btn" string="إنشاء رحلات"
                                invisible="state == 'cancel'"
                                groups="rotana_transport_sale.group_rotana_transport_user"/>
                    </t>
                    <t t-name="card" class="o_transport_order_card cursor-pointer w-100 px-3 py-1 d-flex flex-row flex-wrap align-items-center gap-3">
                        <div t-attf-class="#{record.state.raw_value == 'sale' ? 'bg-success' : (record.state.raw_value == 'cancel' ? 'bg-danger' : 'bg-info')}"
                             style="position: absolute; top: 0; bottom: 0; inset-inline-start: 0; width: 4px;"/>
                        <div class="o_cell d-flex flex-column" style="flex: 1.6 1 12rem; min-width: 0;">
                            <div class="fs-3 text-truncate">
                                <field name="name"/>
                            </div>
                            <div class="small fw-medium d-flex gap-2 align-items-center">
                                <field name="date_order" widget="date"/>
                                <span class="badge rounded-pill border">
                                    <field name="transport_trip_count"/> رحلات
                                </span>
                            </div>
                        </div>
                        <div class="o_cell d-flex flex-column" style="flex: 1.4 1 9rem; min-width: 0;">
                            <div class="fs-4 text-truncate">
                                <field name="partner_id"/>
                            </div>
                            <div class="small fw-medium text-muted">العميل</div>
                        </div>
                        <div class="o_cell d-flex flex-column" style="flex: 1 1 7rem; min-width: 0;">
                            <div class="fs-4 text-truncate">
                                <field name="transport_location_from_id"/>
                            </div>
                            <div class="small fw-medium text-muted">من</div>
                        </div>
                        <div class="o_cell d-flex flex-column" style="flex: 1 1 7rem; min-width: 0;">
                            <div class="fs-4 text-truncate">
                                <field name="transport_location_to_id"/>
                            </div>
                            <div class="small fw-medium text-muted">إلى</div>
                        </div>
                        <div class="o_cell d-flex flex-column" style="flex: 0.8 1 5rem; min-width: 0;">
                            <div class="fs-3 text-truncate">
                                <field name="total_weight_to_transport"/>
                            </div>
                            <div class="small fw-medium text-muted">المطلوب نقله (طن)</div>
                        </div>
                        <div class="o_cell d-flex flex-column" style="flex: 0.8 1 5rem; min-width: 0;">
                            <div class="fs-3 text-truncate">
                                <field name="total_transported_weight"/>
                            </div>
                            <div class="small fw-medium text-muted">المنقول (طن)</div>
                        </div>
                        <div class="o_cell d-flex flex-column" style="flex: 0.8 1 5rem; min-width: 0;">
                            <div class="fs-3 text-truncate">
                                <field name="total_discharged_quantity"/>
                            </div>
                            <div class="small fw-medium text-muted">المفرغ (طن)</div>
                        </div>
                        <div class="o_cell d-flex flex-column gap-1" style="flex: 1 1 7rem; min-width: 0;">
                            <field name="state" widget="badge"
                                   decoration-info="state in ('draft', 'sent')"
                                   decoration-success="state == 'sale'"
                                   decoration-danger="state == 'cancel'"/>
                            <field name="total_transported_weight" widget="progressbar"
                                   options="{'current_value': 'total_transported_weight', 'max_value': 'total_weight_to_transport', 'editable': false}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_rotana_transport_sale_orders" model="ir.actions.act_window">
        <field name="name">أوامر بيع النقل</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_rotana_transport_sale_order_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_rotana_transport_sale_order_tree')})]"/>
        <field name="domain">[('is_transport_order', '=', True)]</field>
        <field name="context">{'default_is_transport_order': True, 'search_default_is_transport_order': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أنشئ أول أمر بيع نقل!</p>
        </field>
    </record>
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('is_transport_order', '=', False)]</field>
        <field name="context">{'default_is_transport_order': False, 'search_default_is_transport_order': 0}</field>
    </record>
</odoo>