<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ============================== -->
    <!-- نموذج الموقع -->
    <!-- ============================== -->
    <record id="view_rotana_transport_location_form" model="ir.ui.view">
        <field name="name">rotana.transport.location.form</field>
        <field name="model">rotana.transport.location</field>
        <field name="arch" type="xml">
            <form string="Transport Location">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Location Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- قائمة المواقع -->
    <record id="view_rotana_transport_location_list" model="ir.ui.view">
        <field name="name">rotana.transport.location.list</field>
        <field name="model">rotana.transport.location</field>
        <field name="arch" type="xml">
            <list string="Transport Locations">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="city"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <!-- بحث المواقع -->
    <record id="view_rotana_transport_location_search" model="ir.ui.view">
        <field name="name">rotana.transport.location.search</field>
        <field name="model">rotana.transport.location</field>
        <field name="arch" type="xml">
            <search string="Search Locations">
                <field name="name" string="Location"/>
                <field name="partner_id" string="Customer"/>
                <field name="city" string="City"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- إجراء المواقع -->
    <record id="action_rotana_transport_location" model="ir.actions.act_window">
        <field name="name">Transport Locations</field>
        <field name="res_model">rotana.transport.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rotana_transport_location_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first transport location!
            </p>
            <p>Departure and arrival locations used in transport trips.</p>
        </field>
    </record>
</odoo>
