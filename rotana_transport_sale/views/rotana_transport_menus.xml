<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ============================== -->
    <!-- قائمة روتانا للنقل -->
    <!-- ============================== -->

    <!-- القائمة الرئيسية -->
    <menuitem id="menu_rotana_transport_root"
              name="Rotana Transport"
              sequence="80"
              web_icon="rotana_transport_sale,static/description/icon.png"
              groups="rotana_transport_sale.group_rotana_transport_user"/>

    <!-- أوامر بيع النقل -->
    <menuitem id="menu_rotana_transport_sales"
              name="Sales"
              parent="menu_rotana_transport_root"
              sequence="10"
              action="action_rotana_transport_sale_orders"
              groups="rotana_transport_sale.group_rotana_transport_user"/>

    <!-- الرحلات -->
    <menuitem id="menu_rotana_transport_operations"
              name="Operations"
              parent="menu_rotana_transport_root"
              sequence="20"
              groups="rotana_transport_sale.group_rotana_transport_user"/>

    <menuitem id="menu_rotana_transport_trips"
              name="Trips"
              parent="menu_rotana_transport_operations"
              sequence="10"
              action="action_rotana_transport_trip"
              groups="rotana_transport_sale.group_rotana_transport_user"/>

    <menuitem id="menu_fleet_vehicle_log"
              name="Vehicle Movement Log"
              parent="menu_rotana_transport_operations"
              sequence="20"
              action="action_fleet_vehicle_log"
              groups="rotana_transport_sale.group_rotana_transport_user"/>

    <!-- الإعدادات -->
    <menuitem id="menu_rotana_transport_config"
              name="Settings"
              parent="menu_rotana_transport_root"
              sequence="90"
              groups="rotana_transport_sale.group_rotana_transport_manager"/>

    <menuitem id="menu_rotana_transport_settings"
              name="Configuration"
              parent="menu_rotana_transport_config"
              sequence="10"
              action="action_rotana_transport_sale_config_settings"
              groups="rotana_transport_sale.group_rotana_transport_manager"/>

    <menuitem id="menu_rotana_transport_locations"
              name="Locations"
              parent="menu_rotana_transport_config"
              sequence="15"
              action="action_rotana_transport_location"
              groups="rotana_transport_sale.group_rotana_transport_manager"/>

    <menuitem id="menu_rotana_transport_vehicles"
              name="Vehicles"
              parent="menu_rotana_transport_config"
              sequence="20"
              action="action_rotana_transport_vehicle"
              groups="rotana_transport_sale.group_rotana_transport_manager"/>

    <menuitem id="menu_rotana_transport_drivers"
              name="Drivers"
              parent="menu_rotana_transport_config"
              sequence="30"
              action="action_rotana_transport_driver"
              groups="rotana_transport_sale.group_rotana_transport_manager"/>
</odoo>
