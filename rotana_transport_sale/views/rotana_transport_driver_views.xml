<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ============================== -->
    <!-- نموذج السائق -->
    <!-- ============================== -->
    <record id="view_rotana_transport_driver_form" model="ir.ui.view">
        <field name="name">rotana.transport.driver.form</field>
        <field name="model">rotana.transport.driver</field>
        <field name="arch" type="xml">
            <form string="Transport Driver">
                <sheet>
                    <widget name="web_ribbon" title="License Expired" bg_color="text-bg-danger"
                            invisible="not is_license_expired"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Driver Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Driving License">
                            <field name="license_number"/>
                            <field name="license_expiry_date"/>
                            <field name="is_license_expired" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- قائمة السائقين -->
    <record id="view_rotana_transport_driver_list" model="ir.ui.view">
        <field name="name">rotana.transport.driver.list</field>
        <field name="model">rotana.transport.driver</field>
        <field name="arch" type="xml">
            <list string="Transport Drivers" decoration-danger="is_license_expired == True">
                <field name="name"/>
                <field name="phone"/>
                <field name="license_number"/>
                <field name="license_expiry_date"/>
                <field name="is_license_expired" widget="boolean" optional="show"/>
            </list>
        </field>
    </record>

    <!-- بحث السائقين -->
    <record id="view_rotana_transport_driver_search" model="ir.ui.view">
        <field name="name">rotana.transport.driver.search</field>
        <field name="model">rotana.transport.driver</field>
        <field name="arch" type="xml">
            <search string="Search Drivers">
                <field name="name" string="Driver"/>
                <field name="license_number" string="License Number"/>
                <separator/>
                <filter string="License Expired" name="expired" domain="[('is_license_expired','=',True)]"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- إجراء السائقين -->
    <record id="action_rotana_transport_driver" model="ir.actions.act_window">
        <field name="name">Transport Drivers</field>
        <field name="res_model">rotana.transport.driver</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rotana_transport_driver_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first driver!
            </p>
        </field>
    </record>
</odoo>
