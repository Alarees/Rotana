<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Upload (batch) -->
    <record id="view_bank_statement_upload_list" model="ir.ui.view">
        <field name="name">bank.statement.upload.list</field>
        <field name="model">bank.statement.upload</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="filename"/>
                <field name="line_count"/>
                <field name="unposted_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_bank_statement_upload_form" model="ir.ui.view">
        <field name="name">bank.statement.upload.form</field>
        <field name="model">bank.statement.upload</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_read_statement" type="object" string="Read Statement"
                            class="btn-primary" invisible="not file"/>
                    <button name="action_post_lines" type="object" string="Post to Bank Statement"
                            invisible="unposted_count == 0"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="line_count"/>
                            <field name="posted_count"/>
                            <field name="unposted_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operations">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="is_posted">
                                    <field name="date"/>
                                    <field name="op_type"/>
                                    <field name="ref"/>
                                    <field name="debit" sum="Total"/>
                                    <field name="credit" sum="Total"/>
                                    <field name="bank_balance" optional="hide"/>
                                    <field name="is_posted"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Operations -->
    <record id="view_bank_statement_upload_line_list" model="ir.ui.view">
        <field name="name">bank.statement.upload.line.list</field>
        <field name="model">bank.statement.upload.line</field>
        <field name="arch" type="xml">
            <list decoration-success="is_posted" create="0">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="op_type"/>
                <field name="ref"/>
                <field name="account_no" optional="show"/>
                <field name="debit" sum="Total"/>
                <field name="credit" sum="Total"/>
                <field name="bank_balance" optional="hide"/>
                <field name="is_posted"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bank_statement_upload_line_form" model="ir.ui.view">
        <field name="name">bank.statement.upload.line.form</field>
        <field name="model">bank.statement.upload.line</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_post_lines" type="object" string="Post to Bank Statement"
                            class="btn-primary" invisible="is_posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="upload_id"/>
                            <field name="journal_id"/>
                            <field name="date"/>
                            <field name="op_type"/>
                            <field name="ref"/>
                            <field name="account_no"/>
                        </group>
                        <group>
                            <field name="debit"/>
                            <field name="credit"/>
                            <field name="amount"/>
                            <field name="bank_balance"/>
                            <field name="is_posted"/>
                            <field name="posted_date"/>
                            <field name="bank_statement_line_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_statement_upload_line_search" model="ir.ui.view">
        <field name="name">bank.statement.upload.line.search</field>
        <field name="model">bank.statement.upload.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref"/>
                <field name="description"/>
                <field name="account_no"/>
                <filter name="not_posted" string="Not Posted" domain="[('is_posted', '=', False)]"/>
                <filter name="posted" string="Posted" domain="[('is_posted', '=', True)]"/>
                <group>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                    <filter name="group_type" string="Operation" context="{'group_by': 'op_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window actions -->
    <record id="action_bank_statement_upload" model="ir.actions.act_window">
        <field name="name">Statement Uploads</field>
        <field name="res_model">bank.statement.upload</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bank_statement_upload_line" model="ir.actions.act_window">
        <field name="name">Statement Operations</field>
        <field name="res_model">bank.statement.upload.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_posted': 1}</field>
    </record>

    <!-- Server actions: post only the not-yet-posted operations -->
    <record id="server_action_post_lines" model="ir.actions.server">
        <field name="name">Post to Bank Statement</field>
        <field name="model_id" ref="model_bank_statement_upload_line"/>
        <field name="binding_model_id" ref="model_bank_statement_upload_line"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_post_lines()</field>
    </record>

    <record id="server_action_post_upload" model="ir.actions.server">
        <field name="name">Post to Bank Statement</field>
        <field name="model_id" ref="model_bank_statement_upload"/>
        <field name="binding_model_id" ref="model_bank_statement_upload"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_post_lines()</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_bank_statement_upload_root" name="Bank Statement Import"
              parent="account.menu_finance_entries" sequence="45"
              groups="account.group_account_readonly,account.group_account_user"/>
    <menuitem id="menu_bank_statement_upload" name="Statement Uploads"
              parent="menu_bank_statement_upload_root" action="action_bank_statement_upload" sequence="1"/>
    <menuitem id="menu_bank_statement_upload_line" name="Operations"
              parent="menu_bank_statement_upload_root" action="action_bank_statement_upload_line" sequence="2"/>
</odoo>
