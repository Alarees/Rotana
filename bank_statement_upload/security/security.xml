<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bank_statement_upload_company" model="ir.rule">
        <field name="name">Bank statement upload: multi-company</field>
        <field name="model_id" ref="model_bank_statement_upload"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bank_statement_upload_line_company" model="ir.rule">
        <field name="name">Bank statement upload line: multi-company</field>
        <field name="model_id" ref="model_bank_statement_upload_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
