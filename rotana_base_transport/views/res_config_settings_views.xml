<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rotana_base" model="ir.ui.view">
        <field name="name">rotana.base.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Rotana" data-string="Rotana" name="rotana_base_transport">
                    <block title="Default Settings" name="default_settings_container">
                        <setting id="parent_analytic_plan_id"
                                 help="The parent analytic plan for transport vehicles. Also used by fleet maintenance.">
                            <field name="parent_analytic_plan_id"/>
                        </setting>
                        <setting id="allowable_deficit"
                                 help="The default allowable deficit for transported weight.">
                            <field name="allowable_deficit"/>
                        </setting>
                    </block>
                    <block title="Financial Custodies" name="custody_settings_container">
                        <setting id="custody_account_id"
                                 help="Custody account (Custody Payable), of type Payable or Receivable, on which driver custodies are recorded.">
                            <field name="custody_account_id"/>
                        </setting>
                        <setting id="custody_journal_id"
                                 help="Journal in which custody entries are created.">
                            <field name="custody_journal_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
