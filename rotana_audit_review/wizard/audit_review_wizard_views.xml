<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="audit_review_wizard_form" model="ir.ui.view">
        <field name="name">audit.review.wizard.form</field>
        <field name="model">audit.review.wizard</field>
        <field name="arch" type="xml">
            <form string="مراجعة Audit Trail">
                <field name="targets" invisible="1"/>
                <field name="action_type" invisible="1"/>
                <group>
                    <field name="targets_count"/>
                </group>
                <group invisible="action_type == 'task'">
                    <field name="note" required="action_type == 'rejected'"
                           placeholder="اكتب الملاحظة (إلزامية عند الرفض)"/>
                </group>
                <group invisible="action_type != 'task'">
                    <field name="activity_type_id" required="action_type == 'task'"/>
                    <field name="summary" required="action_type == 'task'"/>
                    <field name="date_deadline" required="action_type == 'task'"/>
                    <field name="user_id" required="action_type == 'task'"/>
                    <field name="activity_note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="تأكيد"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="إلغاء" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
