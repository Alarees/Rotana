<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_external_workshop_manager" model="res.groups">
        <field name="name">مدير الورشة الخارجية</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rotana_external_workshop_company_rule" model="ir.rule">
        <field name="name">External workshop: multi-company</field>
        <field name="model_id" ref="model_rotana_external_workshop"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
