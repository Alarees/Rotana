<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rotana_management_dashboard.CountUp">
        <span class="rmd-countup" t-esc="text"/>
    </t>

    <t t-name="rotana_management_dashboard.Main">
        <div class="rmd-root">

            <!-- خلفية متحركة -->
            <div class="rmd-bg" aria-hidden="true">
                <div class="rmd-grid"/>
            </div>

            <!-- القائمة الجانبية الرأسية -->
            <aside class="rmd-sidebar">
                <div class="rmd-brand">
                    <span class="rmd-brand-logo"><i class="fa fa-pie-chart"/></span>
                    <div class="rmd-brand-text">
                        <strong>روتانا</strong>
                        <small>لوحة الإدارة</small>
                    </div>
                </div>
                <nav class="rmd-nav">
                    <t t-foreach="sections" t-as="section" t-key="section.id">
                        <button class="rmd-nav-item"
                                t-att-class="{'active': state.section === section.id}"
                                t-on-click="() => this.selectSection(section)">
                            <i t-attf-class="fa {{ section.icon }}"/>
                            <span t-esc="section.label"/>
                        </button>
                    </t>
                </nav>
                <button class="rmd-back" t-on-click="goBack">
                    <i class="fa fa-th-large"/>
                    <span>العودة إلى أودو</span>
                </button>
            </aside>

            <!-- المحتوى -->
            <main class="rmd-main">

                <header class="rmd-header">
                    <div class="rmd-title">
                        <h1>مبيعات الشركات الفرعية</h1>
                        <p>أوامر البيع المؤكدة · <span t-esc="rangeLabel"/></p>
                    </div>
                    <div class="rmd-live" t-att-class="{'busy': state.refreshing}">
                        <span class="rmd-live-dot"/>
                        <span>بث حي</span>
                        <small t-if="state.lastUpdate" t-esc="lastUpdateLabel"/>
                    </div>
                </header>

                <!-- الفلاتر -->
                <section class="rmd-filters">
                    <div class="rmd-company-filter" t-on-click.stop="noop">
                        <button class="rmd-btn" t-on-click="toggleCompanyMenu">
                            <i class="fa fa-building-o"/>
                            <span t-esc="companyFilterLabel"/>
                            <i class="fa fa-angle-down"/>
                        </button>
                        <div class="rmd-menu" t-if="state.companyMenu">
                            <button class="rmd-menu-all" t-on-click="selectAllCompanies">تحديد كل الشركات</button>
                            <t t-foreach="allCompanies" t-as="co" t-key="co.id">
                                <label class="rmd-menu-item">
                                    <input type="checkbox"
                                           t-att-checked="isCompanySelected(co.id)"
                                           t-on-change="() => this.toggleCompany(co.id)"/>
                                    <span class="rmd-dot" t-att-style="'background:' + colorOf(co.id)"/>
                                    <span t-esc="co.name"/>
                                </label>
                            </t>
                        </div>
                    </div>

                    <div class="rmd-toggle rmd-view-toggle" title="العرض الموحّد يجمع مبيعات الشركة الأم مع فروعها">
                        <button t-att-class="{'active': state.consolidated}" t-on-click="() => this.setConsolidated(true)"><i class="fa fa-sitemap"/> موحّد</button>
                        <button t-att-class="{'active': !state.consolidated}" t-on-click="() => this.setConsolidated(false)"><i class="fa fa-building-o"/> مستقل</button>
                    </div>

                    <div class="rmd-presets">
                        <t t-foreach="presets" t-as="preset" t-key="preset.id">
                            <button class="rmd-chip"
                                    t-att-class="{'active': state.preset === preset.id}"
                                    t-on-click="() => this.applyPreset(preset.id)"
                                    t-esc="preset.label"/>
                        </t>
                    </div>

                    <div class="rmd-dates">
                        <label>من <input type="date" t-att-value="state.dateFrom" t-on-change="(ev) => this.onDateChange('from', ev)"/></label>
                        <label>إلى <input type="date" t-att-value="state.dateTo" t-on-change="(ev) => this.onDateChange('to', ev)"/></label>
                    </div>
                </section>

                <div class="rmd-error" t-if="state.error">
                    <i class="fa fa-exclamation-triangle"/> <span t-esc="state.error"/>
                </div>

                <div class="rmd-loading" t-if="state.loading and !state.data">
                    <div class="rmd-spinner"/>
                    <span>جاري تحميل البيانات…</span>
                </div>

                <t t-if="state.section === 'sales' and state.data">

                    <!-- بطاقات الملخص -->
                    <section class="rmd-summary">
                        <article class="rmd-card rmd-kpi" style="--c:#22d3ee">
                            <div class="rmd-kpi-icon"><i class="fa fa-money"/></div>
                            <div class="rmd-kpi-body">
                                <small>إجمالي المبيعات</small>
                                <strong><CountUp value="state.data.totals.total" format="moneyFormat"/></strong>
                                <span class="rmd-badge" t-att-class="growthClass(state.data.totals.growth)"
                                      t-esc="growthText(state.data.totals.growth)"/>
                                <em>مقارنة بالفترة السابقة</em>
                            </div>
                        </article>
                        <article class="rmd-card rmd-kpi" style="--c:#a78bfa">
                            <div class="rmd-kpi-icon"><i class="fa fa-file-text-o"/></div>
                            <div class="rmd-kpi-body">
                                <small>عدد أوامر البيع</small>
                                <strong><CountUp value="state.data.totals.orders" format="countFormat"/></strong>
                            </div>
                        </article>
                        <article class="rmd-card rmd-kpi" style="--c:#34d399">
                            <div class="rmd-kpi-icon"><i class="fa fa-balance-scale"/></div>
                            <div class="rmd-kpi-body">
                                <small>متوسط قيمة الأمر</small>
                                <strong><CountUp value="state.data.totals.avg" format="moneyFormat"/></strong>
                            </div>
                        </article>
                        <article class="rmd-card rmd-kpi" style="--c:#fbbf24">
                            <div class="rmd-kpi-icon"><i class="fa fa-trophy"/></div>
                            <div class="rmd-kpi-body">
                                <small>الأعلى مبيعاً</small>
                                <t t-if="topCompany and topCompany.total > 0">
                                    <strong class="rmd-kpi-name" t-esc="topCompany.name"/>
                                    <em><span t-esc="topShare"/>% من الإجمالي</em>
                                </t>
                                <t t-else="">
                                    <strong class="rmd-kpi-name">—</strong>
                                </t>
                            </div>
                        </article>
                    </section>

                    <!-- بطاقات الشركات -->
                    <h2 class="rmd-section-title">الشركات الفرعية</h2>
                    <section class="rmd-companies">
                        <t t-foreach="state.data.companies" t-as="c" t-key="c.id">
                            <article class="rmd-card rmd-company" t-att-style="'--c:' + colorOf(c.id)"
                                     t-on-click="() => this.openDrawer(c)">
                                <header>
                                    <span class="rmd-dot big"/>
                                    <h3 t-esc="c.name"/>
                                    <span class="rmd-badge" t-att-class="growthClass(c.growth)" t-esc="growthText(c.growth)"/>
                                </header>
                                <div class="rmd-tag" t-if="c.is_parent"><i class="fa fa-sitemap"/> موحّد · يشمل <span t-esc="c.branches"/> فرع</div>
                                <div class="rmd-company-total"><CountUp value="c.total" format="moneyFormat"/></div>
                                <div class="rmd-company-meta">
                                    <span><i class="fa fa-file-text-o"/> <span t-esc="c.orders"/> أمر</span>
                                    <span><i class="fa fa-balance-scale"/> <span t-esc="moneyCompact(c.avg)"/> متوسط</span>
                                </div>
                                <svg class="rmd-spark" viewBox="0 0 120 36" preserveAspectRatio="none">
                                    <path class="area" t-att-d="sparkArea(c.series)"/>
                                    <path class="line" t-att-d="sparkLine(c.series)"/>
                                </svg>
                                <div class="rmd-share">
                                    <div class="rmd-share-bar"><span t-att-style="'width:' + c.share + '%'"/></div>
                                    <small><span t-esc="c.share"/>% من الإجمالي</small>
                                </div>
                            </article>
                        </t>
                        <div class="rmd-empty" t-if="!hasData">لا توجد شركات لعرضها.</div>
                    </section>

                    <!-- الرسوم -->
                    <section class="rmd-charts" t-if="hasData">
                        <article class="rmd-card rmd-chart-card wide">
                            <header>
                                <h3>مقارنة مبيعات كل شركة بذاتها</h3>
                                <div class="rmd-toggle">
                                    <button t-att-class="{'active': state.chartMode === 'line'}" t-on-click="() => this.setChartMode('line')"><i class="fa fa-area-chart"/> خطوط</button>
                                    <button t-att-class="{'active': state.chartMode === 'column'}" t-on-click="() => this.setChartMode('column')"><i class="fa fa-bar-chart"/> أعمدة</button>
                                </div>
                            </header>
                            <div class="rmd-chart rmd-chart-compare"/>
                        </article>
                        <article class="rmd-card rmd-chart-card">
                            <header><h3>حصة كل شركة (بذاتها)</h3></header>
                            <div class="rmd-chart rmd-chart-share"/>
                        </article>
                    </section>
                </t>
            </main>

            <!-- لوحة التفاصيل الجانبية -->
            <div class="rmd-overlay" t-if="state.drawer.open" t-on-click="closeDrawer"/>
            <aside class="rmd-drawer" t-att-class="{'open': state.drawer.open}">
                <t t-if="state.drawer.open">
                    <header class="rmd-drawer-head" t-att-style="'--c:' + colorOf(state.drawer.company.id)">
                        <span class="rmd-dot big"/>
                        <h2><span t-esc="state.drawer.company.name"/></h2>
                        <button class="rmd-close" t-on-click="closeDrawer"><i class="fa fa-times"/></button>
                    </header>

                    <div class="rmd-loading small" t-if="state.drawer.loading and !state.drawer.data">
                        <div class="rmd-spinner"/>
                    </div>

                    <div class="rmd-drawer-body" t-if="state.drawer.data" t-att-style="'--c:' + colorOf(state.drawer.company.id)">
                        <div class="rmd-tag" t-if="state.drawer.data.company.branches > 0"><i class="fa fa-sitemap"/> موحّد · يشمل <span t-esc="state.drawer.data.company.branches"/> فرع</div>
                        <div class="rmd-mini-grid">
                            <div class="rmd-mini">
                                <small>المبيعات</small>
                                <strong t-esc="money(state.drawer.data.totals.total)"/>
                                <span class="rmd-badge" t-att-class="growthClass(state.drawer.data.totals.growth)"
                                      t-esc="growthText(state.drawer.data.totals.growth)"/>
                            </div>
                            <div class="rmd-mini">
                                <small>الأوامر</small>
                                <strong t-esc="state.drawer.data.totals.orders"/>
                            </div>
                            <div class="rmd-mini">
                                <small>المتوسط</small>
                                <strong t-esc="money(state.drawer.data.totals.avg)"/>
                            </div>
                        </div>

                        <h4>المبيعات عبر الزمن</h4>
                        <div class="rmd-chart small rmd-chart-drawer-line"/>

                        <t t-if="state.drawer.data.products.length">
                            <h4>أفضل المنتجات</h4>
                            <div class="rmd-chart small rmd-chart-drawer-products"/>
                        </t>

                        <h4>أفضل العملاء</h4>
                        <ul class="rmd-rank">
                            <t t-foreach="state.drawer.data.customers" t-as="item" t-key="item_index">
                                <li>
                                    <span class="n" t-esc="item_index + 1"/>
                                    <span class="name" t-esc="item.name"/>
                                    <span class="val" t-esc="moneyCompact(item.value)"/>
                                </li>
                            </t>
                            <li class="rmd-empty" t-if="!state.drawer.data.customers.length">لا توجد بيانات</li>
                        </ul>

                        <h4>أفضل مندوبي المبيعات</h4>
                        <ul class="rmd-rank">
                            <t t-foreach="state.drawer.data.salespeople" t-as="item" t-key="item_index">
                                <li>
                                    <span class="n" t-esc="item_index + 1"/>
                                    <span class="name" t-esc="item.name"/>
                                    <span class="val" t-esc="moneyCompact(item.value)"/>
                                </li>
                            </t>
                            <li class="rmd-empty" t-if="!state.drawer.data.salespeople.length">لا توجد بيانات</li>
                        </ul>
                    </div>
                </t>
            </aside>
        </div>
    </t>

</templates>
